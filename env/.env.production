APP_ENV=production
NODE_ENV=production
SERVICE_NAME=api-gateway
PORT=3000
REDIS_URL=redis://localhost:16379/2
REDIS_QUEUE_PREFIX=lec.prod
REDIS_DB=2
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=7
REDIS_ENABLE_TLS=false
DATABASE_URL=postgres://app:app@localhost:15432/lecture_flashcards_prod

ARTIFACTS_DIR=/app/storage
