APP_ENV=local
NODE_ENV=development
SERVICE_NAME=api-gateway
PORT=3000
REDIS_URL=redis://localhost:16379/0
REDIS_QUEUE_PREFIX=lec.local
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_ENABLE_TLS=false
DATABASE_URL=postgres://app:app@localhost:15432/lecture_flashcards
TRANSCRIPTION_PROVIDER_TIMEOUT_MS=120000

ARTIFACTS_DIR=/app/storage
OPENAI_API_KEY=
OPENAI_FALLBACK_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=arcee-ai/trinity-large-preview:free
SUMMARY_AI_TIMEOUT_MS=180000
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
