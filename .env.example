# Compose storage
POSTGRES_DB=lecture_flashcards
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Runtime profile
APP_ENV=local
NODE_ENV=development
REDIS_QUEUE_PREFIX=lec.local
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_ENABLE_TLS=false
TRANSCRIPTION_CHUNK_SIZE_CHARS=800
TRANSCRIPTION_MAX_PARALLEL_CHUNKS=4
TRANSCRIPTION_CHUNK_DELAY_MS=25
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_PROVIDER_TIMEOUT_MS=45000
TRANSCRIPTION_PROVIDER_RETRY_ATTEMPTS=2
TRANSCRIPTION_PROVIDER_RETRY_DELAY_MS=1000
TRANSCRIPTION_OPENAI_MODEL=whisper-1
DEEPGRAM_MODEL=nova-3
# DEEPGRAM_API_KEY=
# DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
# Optional dedicated STT credentials (if omitted, falls back to OPENAI_* below)
# TRANSCRIPTION_OPENAI_API_KEY=
# TRANSCRIPTION_OPENAI_BASE_URL=https://api.openai.com/v1
JOB_RESULT_POLL_INTERVAL_MS=2000
JOB_EXPECTED_MAX_PROCESSING_MS=900000
UPLOAD_MAX_FILE_SIZE_BYTES=209715200

# Service connections inside docker network
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgres://app:app@postgres:5432/lecture_flashcards

ARTIFACTS_DIR=/app/storage

# Optional LLM settings for flashcard-worker
# OPENAI_API_KEY=
# OPENAI_FALLBACK_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
URL_PARSER_SERVICE_URL=http://url-parser-service:8000
URL_PARSER_TIMEOUT_MS=180000
VIDEO_PARSER_SERVICE_URL=http://video-parser-service:8000
VIDEO_PARSER_TIMEOUT_MS=300000
# Optional dedicated crawl4ai credentials (if omitted, falls back to OPENAI_API_KEY)
# CRAWL4AI_API_KEY=
CRAWL4AI_LLM_PROVIDER=openai/gpt-4.1-mini
CRAWL4AI_MAX_TEXT_CHARS=400000
# yt_dlp downloader settings
VIDEO_PARSER_SOCKET_TIMEOUT_SEC=45
VIDEO_PARSER_FORMAT=bestaudio/best
SUMMARY_AI_TIMEOUT_MS=180000

# API Gateway authentication
AUTH_JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-32-chars
AUTH_JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-32-chars
AUTH_JWT_ISSUER=lecture-api
AUTH_JWT_AUDIENCE=lecture-client
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_USER_LOGIN=admin
AUTH_USER_PASSWORD=admin
# Optional social auth
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_TELEGRAM_BOT_TOKEN=
# AUTH_TELEGRAM_BOT_USERNAME=
