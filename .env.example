# Compose storage
POSTGRES_DB=lecture_flashcards
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Runtime profile
APP_ENV=local
NODE_ENV=development
REDIS_QUEUE_PREFIX=lec.local
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_ENABLE_TLS=false
TRANSCRIPTION_CHUNK_SIZE_CHARS=800
TRANSCRIPTION_MAX_PARALLEL_CHUNKS=4
TRANSCRIPTION_CHUNK_DELAY_MS=25
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_PROVIDER_TIMEOUT_MS=45000
TRANSCRIPTION_PROVIDER_RETRY_ATTEMPTS=2
TRANSCRIPTION_PROVIDER_RETRY_DELAY_MS=1000
TRANSCRIPTION_OPENAI_MODEL=whisper-1
DEEPGRAM_MODEL=nova-3
# DEEPGRAM_API_KEY=
# DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
# Optional dedicated STT credentials (if omitted, falls back to OPENAI_* below)
# TRANSCRIPTION_OPENAI_API_KEY=
# TRANSCRIPTION_OPENAI_BASE_URL=https://api.openai.com/v1
JOB_RESULT_POLL_INTERVAL_MS=2000
JOB_EXPECTED_MAX_PROCESSING_MS=900000
UPLOAD_MAX_FILE_SIZE_BYTES=209715200

# Service connections inside docker network
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgres://app:app@postgres:5432/lecture_flashcards

ARTIFACTS_DIR=/app/storage

# Optional LLM settings for flashcard-worker
# OPENAI_API_KEY=
# OPENAI_FALLBACK_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
SUMMARY_AI_TIMEOUT_MS=180000
